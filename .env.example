# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here-do-not-leak
DEBUG=True
ALLOWED_HOSTS=*
DB_NAME=db.sqlite3

# Redis / Celery (Optional fallback)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Product API Client Configuration
PRODUCT_API_PROVIDER=null
PRODUCT_API_KEY=your_rapidapi_or_serpapi_key_here
